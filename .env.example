# Production origin (canonical URLs, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# JSON webhook that receives project inquiries (Formspree, Zapier, Make, n8n, Slack, CRM)
INQUIRY_WEBHOOK_URL=

# Optional: browser-side relay (FormSubmit AJAX URL). Takes priority over INQUIRY_WEBHOOK_URL.
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Optional: search engine verification codes
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Client portal
DATABASE_URL=
AUTH_SECRET=
